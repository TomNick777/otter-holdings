{
  "name": "otter-holdings-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --production",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "audit:public": "node scripts/audit.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm audit:public"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
